rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidContactSubmission() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'firstName', 'lastName', 'email', 'phone', 'company', 'message', 'service', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'firstName', 'lastName', 'email', 'phone', 'company', 'message', 'service', 'status', 'createdAt'
        ])
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100
        && data.email is string && data.email.size() <= 254
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.phone is string && data.phone.size() <= 40
        && data.company is string && data.company.size() <= 160
        && data.message is string && data.message.size() > 0 && data.message.size() <= 5000
        && data['service'] is string && data['service'].size() <= 120
        && data.status == 'new'
        && data.createdAt == request.time;
    }

    match /contact_submissions/{submissionId} {
      allow create: if isValidContactSubmission();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
